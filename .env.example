# Copy to .env and fill in. .env is git-ignored.

# Required for live SEC requests. SEC asks automated clients to declare who they are:
# an application name plus a real contact email you control. There is no default.
# Example format: TickerCase/0.1 Your Name you@your-domain.com
SEC_USER_AGENT=

# Default SEC data mode for the API: live | record | replay | synthetic
TICKERCASE_SEC_MODE=live

# Where record mode writes snapshots and replay mode reads them.
TICKERCASE_SNAPSHOT_DIR=data/snapshots/live

# Where evaluated cases are stored as JSON.
TICKERCASE_CASE_DIR=data/cases

# Network limits for live SEC calls.
SEC_TIMEOUT_SECONDS=10
SEC_MAX_RETRIES=2
SEC_MIN_INTERVAL_SECONDS=0.2
SEC_MAX_RETRY_AFTER_SECONDS=30

# AI narrative (optional). The key can also come from `ant auth login`.
# ANTHROPIC_API_KEY=
# Model and effort for the narrative: claude-opus-5-5 | claude-sonnet-5-5 | claude-haiku-4-5;
# effort low | medium | high | xhigh | max (ignored for Haiku).
TICKERCASE_NARRATIVE_MODEL=claude-opus-5-5
TICKERCASE_NARRATIVE_EFFORT=medium

# The page opens on a start-up screen (about 1.5 s, then ENTER). 0 opens the console directly.
TICKERCASE_BOOT_SCREEN=1
